# ============================================================
#  SmartHotelOS — Variables de Entorno
#  Grupo Smart de Administración
#  ⚠️  Copiar a .env y nunca commitear .env
# ============================================================

# --- Entorno ---
APP_ENV=development
APP_DEBUG=true
APP_NAME="SmartHotelOS"
APP_URL=http://localhost:8080

# --- Base de Datos ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smart_hotel_db
DB_USER=smart_user
DB_PASSWORD=smart_secret
DB_ROOT_PASSWORD=root_smart_2024

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_smart
REDIS_DB=0

# --- Email ---
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@smarthotelgroup.com"
MAIL_FROM_NAME="Smart Hotel Group"

# --- Pagos ---
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

MERCADOPAGO_PUBLIC_KEY=TEST-...
MERCADOPAGO_ACCESS_TOKEN=TEST-...

# --- WhatsApp Business API ---
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=smart_hotel_wab_verify

# --- Channel Manager ---
CHANNEL_MANAGER_API_URL=
CHANNEL_MANAGER_API_KEY=
CHANNEL_MANAGER_HOTEL_CODE=

# --- JWT (API Auth) ---
JWT_SECRET=change_this_super_secret_jwt_key_256bits
JWT_TTL=1440

# --- Admin ---
SMART_ADMIN_FOLDER=admin-smart
SMART_ADMIN_TOKEN=

# --- Propiedades ---
DEFAULT_PROPERTY_ID=1
DEFAULT_PROPERTY_CODE=SMART01
DEFAULT_TIMEZONE=America/Santiago
DEFAULT_CURRENCY=CLP

# --- Features Flags ---
FEATURE_HOUSEKEEPING=true
FEATURE_RESTAURANT=false
FEATURE_SPA=false
FEATURE_IOT=false
FEATURE_AI_FORECASTING=false
FEATURE_WHATSAPP_BOT=false
